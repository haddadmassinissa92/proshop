# --- Base de données ---
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net

# --- Authentification ---
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# --- Serveur ---
PORT=3000
# URL publique du frontend (pour CORS + redirections après paiement)
CLIENT_URL=http://localhost:5173
# URL publique de CE backend (utilisée par SATIM pour les retours de paiement)
SERVER_URL=http://localhost:3000

# =========================================================
# CLOUDINARY (stockage des images : produits, catégories, avatars)
# Compte gratuit sur https://cloudinary.com — une fois connecté, les 3
# valeurs ci-dessous sont affichées directement sur la page d'accueil du
# dashboard ("Product Environment Credentials" / "API Environment variable").
# =========================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================================================
# RESEND (email de confirmation de commande)
# Compte gratuit sur https://resend.com (3000 emails/mois gratuits).
# Clé API : Dashboard -> API Keys -> Create API Key.
#
# ATTENTION : sans domaine vérifié sur Resend, tu ne peux envoyer des
# emails QU'À l'adresse avec laquelle tu as créé ton compte Resend (mode
# test/sandbox) — impossible d'envoyer à de vrais clients avant d'avoir
# vérifié un nom de domaine (Dashboard -> Domains -> Add Domain, avec des
# enregistrements DNS à ajouter chez ton hébergeur de domaine).
# =========================================================
RESEND_API_KEY=
# Adresse d'expéditeur. "onboarding@resend.dev" fonctionne sans domaine
# vérifié (mais seulement en mode test, voir note ci-dessus). Une fois ton
# domaine vérifié : quelque chose comme "commandes@ton-domaine.com".
EMAIL_FROM=onboarding@resend.dev

# =========================================================
# CIB / EDAHABIA (SATIM)
# Nécessite un contrat "Vente à Distance" (VAD) signé avec une banque
# partenaire SATIM (BNA, BEA, CPA...) ou avec Algérie Poste, puis la
# certification technique par SATIM. Ces identifiants te sont transmis par
# SATIM à l'issue de ce processus (compter quelques semaines).
# =========================================================
SATIM_USERNAME=
SATIM_PASSWORD=
# URL de test fournie par SATIM pendant la phase de certification,
# remplacée par l'URL de production une fois validé.
SATIM_URL=https://test.satim.dz
